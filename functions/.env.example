# Stripe price IDs — copy this file to `.env` and fill in real values.
# These are NOT secret (they appear at checkout), so they live here rather
# than in Secret Manager. The two SECRETS (sk_... and whsec_...) are stored
# separately:  firebase functions:secrets:set STRIPE_SECRET
#              firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# Create one recurring Price per row in the Stripe dashboard, then paste its
# price_... id here.
STRIPE_PRICE_BASE_MONTHLY=price_xxx    # base monthly  ($27)
STRIPE_PRICE_BASE_ANNUAL=price_xxx     # base annual   ($230)
STRIPE_PRICE_SIRAT_MONTHLY=price_xxx   # sirat monthly ($38)
STRIPE_PRICE_SIRAT_ANNUAL=price_xxx    # sirat annual  ($300)
