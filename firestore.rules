rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
// Niyyah — Firestore Security Rules
// ────────────────────────────────────────────────────────────────────────
// The "your data stays yours" landing-page promise is enforced HERE.
// Without these rules deployed, anyone with the public Firebase API key
// could read every user's data.
//
// `subscription`, `stripeCustomerId`, `stripeSubscriptionId` are
// server-only — the Cloud Functions backend uses the Admin SDK, which
// bypasses these rules entirely, so the webhook can still write them.
// A malicious client cannot mint themselves an active subscription.
//
// Deploy:  firebase deploy --only firestore:rules
// ════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('subscription' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['subscription', 'stripeCustomerId', 'stripeSubscriptionId']);

      // Delete: used by "Delete account permanently" and "Reset all data"
      // in Settings. Owner only.
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Reserved for future server-side rate limiting. Clients cannot read
    // or write — only Admin SDK from a Cloud Function may touch this.
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // Lock everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
